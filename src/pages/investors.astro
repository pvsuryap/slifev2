---
import Base from '../layouts/Base.astro';
import { SITE, EMAILS } from '../lib/config';

const description =
  "Discover Sweeyam Life's thoughtful approach to building an accessible premium lifestyle and self-care brand for India.";
---

<Base title="Investors & Strategic Partners | Sweeyam Life" description={description}>
  <!-- Hero -->
  <section class="page-hero navy-hero" id="top">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow on-dark">Investor overview &middot; India &middot; Pre-launch</p>
        <h1 class="on-dark">Building India's thoughtful everyday-living brand.</h1>
        <p class="hero-lede on-dark-soft">
          Premium lifestyle and self-care brand. Rooted in nature, built thoughtfully, with products that are
          <span class="mark on-dark">— Kind to you and the Earth.</span>
        </p>
        <div class="button-row">
          <a class="button button-brass" href="#opportunity">View the opportunity</a>
          <a class="button button-on-dark" href={`mailto:${EMAILS.investors}?subject=Investor%20conversation%20with%20Sweeyam%20Life`}>Start a conversation</a>
        </div>
      </div>
      <aside class="thesis on-dark" aria-label="The investment thesis">
        <span class="thesis-label">The investment thesis</span>
        <ol class="thesis-list">
          <li><strong>A trusted house of products</strong> One promise across recurring self-care and lifestyle rituals.</li>
          <li><strong>A focused launch wedge</strong> Hygiene and nourishing products establish the brand before category expansion.</li>
          <li><strong>A disciplined operating model</strong> Asset-light production, shared platforms and digital systems support measured growth.</li>
        </ol>
      </aside>
    </div>
  </section>

  <!-- Our Promise -->
  <section class="promise" id="promise">
    <div class="shell">
      <div class="split-intro reveal">
        <div>
          <p class="eyebrow">Our Promise</p>
          <h2 class="section-title">Everyday care should do more than serve a purpose. <span class="mark investors-mark">—&nbsp;It should carry meaning.</span></h2>
        </div>
      </div>
      <div class="principle-grid reveal">
        <article class="principle">
          <span class="number">01</span>
          <h3>Efficacy first</h3>
          <p>Products must deliver what they promise. Thoughtful formulation, testing and refinement are the starting point, not supporting claims.</p>
        </article>
        <article class="principle">
          <span class="number">02</span>
          <h3>Accessible premium</h3>
          <p>A premium experience built through care, design and honesty — not exclusion, excess or unnecessary complexity.</p>
        </article>
        <article class="principle">
          <span class="number">03</span>
          <h3>Care beyond use</h3>
          <p>Materials, makers, systems and choices are considered for their wider impact on people and the Earth.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- The Opportunity -->
  <section class="opportunity-section" id="opportunity">
    <div class="shell opportunity-layout">
      <div class="opportunity-copy reveal">
        <p class="eyebrow">The Opportunity</p>
        <h2 class="section-title">Familiar categories. Fragmented choices. <span class="mark opportunity-mark">—&nbsp;Room for a trusted everyday brand.</span></h2>
        <p class="lede">
          Indian consumers increasingly discover brands digitally, expect more from product experience and look for credible choices that align performance with responsibility.
        </p>
        <p>
          Sweeyam Life brings these expectations together within one coherent house of products — beginning with high-frequency self-care rituals, building trust through everyday experience, and creating a natural pathway into a broader, more meaningful product range.
        </p>
        <a class="button button-brass" href={`mailto:${EMAILS.investors}?subject=Request%20for%20Sweeyam%20Life%20investor%20brief`}>Request the investor brief</a>
      </div>
      <div class="value-chain-column reveal">
        <p class="eyebrow">How value compounds</p>
        <div class="value-chain">
          <article class="value-step"><h3>Earn trust</h3><p>Effective products in recurring everyday rituals.</p></article>
          <article class="value-step"><h3>Build the relationship</h3><p>A recognisable experience across products and channels.</p></article>
          <article class="value-step"><h3>Extend the basket</h3><p>Adjacent categories served by the same trusted promise.</p></article>
          <article class="value-step"><h3>Scale the system</h3><p>Reusable platforms, partner capacity and channel discipline.</p></article>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Philosophy -->
  <section class="representations" id="product-representations">
    <div class="shell">
      <div class="narrow reveal">
        <p class="eyebrow">Brand Philosophy</p>
        <h2 class="section-title">One identity, expressed through <span class="mark">repeatable product platforms.</span></h2>
        <p class="lede">
          These directional concepts show how Sweeyam Life's brand system could extend across formats while keeping the portfolio recognisable, premium and operationally coherent.
        </p>
      </div>
      <div class="representation-philosophy reveal">
        <div class="representation-media">
          <img loading="lazy" decoding="async" src="/images/Representation_13.png" alt="Sweeyam Life brand philosophy expressed across everyday living" />
          <div class="philosophy-panel" aria-hidden="true">
            <h3 class="philosophy-title animate slide-left pop delay-1">Strategic Differentiators</h3>
            <ul class="philosophy-list">
              <li class="animate slide-left pop delay-2">Meaningful Product Intent</li>
              <li class="animate slide-left pop delay-3">Disciplined Product Development</li>
              <li class="animate slide-left pop delay-4">Performance and Efficacy</li>
              <li class="animate slide-left pop delay-5">Accessible Premium Experience</li>
              <li class="animate slide-left pop delay-6">Radical Honesty</li>
              <li class="animate slide-left pop delay-7">India-First Relevance</li>
              <li class="animate slide-left pop delay-8">Creative Enterprise Supported by Systems</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="values-section on-dark" id="core-values">
    <div class="shell">
      <div class="values-heading reveal">
        <p class="eyebrow on-dark">Core Values</p>
        <h2 class="section-title on-dark">Five principles. <span class="mark on-dark values-mark">—&nbsp;One standard for every decision.</span></h2>
      </div>
      <div class="value-rail reveal" aria-label="Sweeyam Life core values">
        <article class="value-card">
          <span class="value-letter" aria-hidden="true">J</span>
          <h3>Joyfulness</h3>
          <p>Wellness that is fun, playful and creatively expressive.</p>
        </article>
        <article class="value-card">
          <span class="value-letter" aria-hidden="true">E</span>
          <h3>Efficacy</h3>
          <p>Scientifically proven formulas that deliver results.</p>
        </article>
        <article class="value-card">
          <span class="value-letter" aria-hidden="true">S</span>
          <h3>Sustainability</h3>
          <p>Responsible sourcing with a minimal carbon footprint.</p>
        </article>
        <article class="value-card">
          <span class="value-letter" aria-hidden="true">T</span>
          <h3>Transparency</h3>
          <p>Honesty about ingredients, processes and pricing.</p>
        </article>
        <article class="value-card">
          <span class="value-letter" aria-hidden="true">I</span>
          <h3>Inclusivity</h3>
          <p>Serving every skin tone, hair type, gender and age.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Built for disciplined growth -->
  <section class="scale-section" id="scale">
    <div class="shell scale-grid">
      <div class="reveal">
        <p class="eyebrow">Built for disciplined growth</p>
        <h2 class="section-title">A brand with human warmth <span class="mark scale-mark">—&nbsp;and an operating system behind it.</span></h2>
      </div>
      <div class="scale-points reveal">
        <article class="scale-point">
          <h3>Shared platforms</h3>
          <p>Common standards for product engineering, packaging, quality and supplier execution.</p>
        </article>
        <article class="scale-point">
          <h3>Asset-light capacity</h3>
          <p>Approved manufacturing and specialist partners expand capability without unnecessary fixed infrastructure.</p>
        </article>
        <article class="scale-point">
          <h3>Channel discipline</h3>
          <p>DTC, marketplaces, retail and institutional channels are developed with clear economics and distinct roles.</p>
        </article>
        <article class="scale-point">
          <h3>Digital operating backbone</h3>
          <p>Connected systems support traceability, decisions and a consistent customer experience.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Grow With Us -->
  <section class="grow-section" id="grow">
    <div class="shell grow-grid">
      <div class="reveal">
        <p class="eyebrow">Grow With Us</p>
        <h2 class="section-title">Partner with a brand built for <span class="mark grow-mark">—&nbsp;patient ambition and disciplined growth.</span></h2>
        <p class="lede">
          We welcome conversations with investors and partners who share our beliefs and want to create an enduring consumer and enterprise value.
        </p>
        <div class="button-row">
          <a class="button button-brass" href={`mailto:${EMAILS.investors}?subject=Investor%20conversation%20with%20Sweeyam%20Life`}>Start a conversation</a>
          <a class="button button-on-dark" href={`mailto:${EMAILS.investors}?subject=Request%20for%20Sweeyam%20Life%20investor%20brief`}>Request the investor brief</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .navy-hero {
    padding-block: calc(var(--header-h) + var(--space-section-compact)) var(--space-section-compact);
    background:
      radial-gradient(60% 70% at 85% 15%, rgba(217, 194, 152, 0.14), transparent 60%),
      radial-gradient(70% 75% at 8% 100%, rgba(40, 75, 119, 0.65), transparent 62%),
      radial-gradient(45% 55% at 4% 92%, rgba(217, 194, 152, 0.1), transparent 55%),
      var(--navy-deep);
  }
  .button-row { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: flex-start;
  }
  .hero-grid h1 { max-width: 18ch; margin-bottom: var(--space-md); }
  .hero-lede { max-width: 40rem; margin-bottom: var(--space-lg); font-size: var(--text-body); }

  .thesis { border: 1px solid rgba(244, 239, 230, 0.18); border-radius: var(--radius-lg); padding: var(--space-lg); background: rgba(255, 253, 249, 0.04); }
  .thesis-label { display: block; margin-bottom: var(--space-md); font-size: var(--text-caption-up); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brass-light); }
  .thesis-list { margin: 0; padding: 0; list-style: none; counter-reset: thesis; }
  .thesis-list li { counter-increment: thesis; position: relative; padding-left: 2.25rem; padding-block: var(--space-sm); border-bottom: 1px solid rgba(244, 239, 230, 0.12); color: var(--on-dark-soft); }
  .thesis-list li:last-child { border-bottom: 0; }
  .thesis-list li::before { content: counter(thesis, decimal-leading-zero); position: absolute; left: 0; top: var(--space-sm); font-family: var(--font-display); font-size: var(--text-caption-up); color: var(--brass); }
  .thesis-list strong { display: block; margin-bottom: 0.2rem; color: var(--on-dark); font-weight: 600; }

  /* Promise */
  .promise { padding-block: var(--space-section); }
  .investors-mark { font-style: italic; }
  .opportunity-mark { font-style: italic; color: var(--green); }
  .split-intro { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; margin-bottom: var(--space-xl); }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .principle { padding: var(--space-lg); border: 1px solid var(--hairline); border-radius: var(--radius-lg); background: var(--surface-card); transition: transform var(--dur-normal) var(--ease), box-shadow var(--dur-normal) var(--ease); }
  .principle:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft); }
  .principle .number { display: block; margin-bottom: var(--space-md); font-family: var(--font-display); color: var(--brass-deep); }
  .principle h3 { margin-bottom: 0.5rem; }

  /* Opportunity */
  .opportunity-section { padding-block: var(--space-section); background: var(--surface-soft); }
  .opportunity-layout { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .opportunity-copy .lede { font-size: var(--text-body); }
  .opportunity-copy > p { max-width: 40rem; }
  .opportunity-copy .button { margin-top: var(--space-md); }

  .value-chain-column { position: sticky; top: calc(var(--header-h) + 2rem); }
  .value-chain { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .value-step { padding: var(--space-md); border: 1px solid var(--hairline); border-radius: var(--radius-md); background: var(--surface-card); }
  .value-step h3 { font-size: var(--text-display-sm); margin-bottom: 0.35rem; }
  .value-step p { margin: 0; font-size: var(--text-body); }

  /* Representations */
  .representations { padding-block: var(--space-section); }
  .narrow { max-width: 44rem; margin-bottom: var(--space-xl); }
  .representation-philosophy {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-soft);
    width: 90%;
  }
  .representation-philosophy .representation-media {
    position: relative;
    display: grid;
    place-items: start start;
  }
  .representation-philosophy img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .philosophy-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 55%;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(120deg, var(--navy-deep), var(--navy));
    border-left: 1px solid rgba(217, 194, 152, 0.35);
    transform: translateX(101%);
    transition: transform var(--dur-normal) var(--ease);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .representation-philosophy:hover .philosophy-panel,
  .representation-philosophy:focus-within .philosophy-panel {
    transform: translateX(0);
  }
  .philosophy-title {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    color: var(--brass-light);
    margin-bottom: var(--space-lg);
  }
  .philosophy-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .philosophy-list li {
    color: var(--on-dark-soft);
    font-size: var(--text-body);
    line-height: 1.5;
    padding-block: 0.35rem;
    border-bottom: 1px solid rgba(244, 239, 230, 0.1);
  }
  .philosophy-list li:last-child { border-bottom: 0; }

  .animate { animation-duration: 0.7s; animation-timing-function: cubic-bezier(0.26, 0.53, 0.74, 1.48); animation-fill-mode: backwards; }
  .pop { animation-name: pop; }
  @keyframes pop {
    0% { opacity: 0; transform: scale(0.5, 0.5); }
    100% { opacity: 1; transform: scale(1, 1); }
  }
  .slide-left { animation-name: slide-left; }
  @keyframes slide-left {
    0% { opacity: 0; transform: translate(-40px, 0); }
    100% { opacity: 1; transform: translate(0, 0); }
  }
  .delay-1 { animation-delay: 0.3s; }
  .delay-2 { animation-delay: 0.6s; }
  .delay-3 { animation-delay: 0.9s; }
  .delay-4 { animation-delay: 1.2s; }
  .delay-5 { animation-delay: 1.5s; }
  .delay-6 { animation-delay: 1.8s; }
  .delay-7 { animation-delay: 2.1s; }
  .delay-8 { animation-delay: 2.4s; }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .philosophy-panel {
      position: static;
      width: 100%;
      transform: none;
      border-left: 0;
      border-top: 1px solid rgba(217, 194, 152, 0.35);
    }
    .animate { animation: none; opacity: 1; }
  }
  /* Core values */
  .values-section { padding-block: var(--space-section); background: var(--navy-deep); }
  .values-heading { max-width: 36rem; margin-bottom: var(--space-xl); }
  .values-mark { font-style: italic; }
  .value-rail { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-md); }
  .value-card { padding: var(--space-lg) var(--space-md); border: 1px solid rgba(244, 239, 230, 0.18); border-radius: var(--radius-lg); background: rgba(255, 253, 249, 0.04); transition: transform var(--dur-normal) var(--ease), border-color var(--dur-normal) var(--ease); }
  .value-card:hover { transform: translateY(-4px); border-color: var(--brass-light); }
  .value-letter { display: block; font-family: var(--font-display); font-size: var(--text-display-sm); color: var(--brass); margin-bottom: var(--space-md); }
  .value-card h3 { color: var(--on-dark); font-size: var(--text-display-sm); margin-bottom: 0.4rem; }
  .value-card p { margin: 0; font-size: var(--text-body); color: var(--on-dark-soft); }

  /* Scale */
  .scale-section { padding-block: var(--space-section); }
  .scale-mark { font-style: italic; }
  .scale-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .scale-points { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .scale-point { padding: var(--space-lg); border: 1px solid var(--hairline); border-radius: var(--radius-lg); background: var(--surface-card); }
  .scale-point h3 { margin-bottom: 0.5rem; }

  /* Grow */
  .grow-section { padding-block: var(--space-section); background: var(--surface-soft); }
  .grow-mark { font-style: italic; color: var(--green); }

  @media (max-width: 62rem) {
    .hero-grid, .split-intro, .opportunity-layout, .scale-grid { grid-template-columns: 1fr; }
    .principle-grid, .value-rail, .value-chain, .scale-points { grid-template-columns: 1fr 1fr; }
    .value-chain-column { position: static; }
  }
  @media (max-width: 48rem) {
    .principle-grid, .value-rail, .value-chain, .scale-points { grid-template-columns: 1fr; }
  }
</style>
