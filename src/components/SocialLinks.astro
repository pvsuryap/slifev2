  WhatsApp:
    'M20.52 3.48A11.8 11.8 0 0 0 1.96 17.7L.3 23.75l6.2-1.63A11.78 11.78 0 0 0 12 23.5h.01A11.8 11.8 0 0 0 20.52 3.48zM12 21.5a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.68.97.98-3.59-.23-.37A9.8 9.8 0 1 1 12 21.5zm5.38-7.34c-.29-.15-1.73-.85-2-.95-.27-.1-.47-.15-.67.15-.2.29-.77.95-.94 1.14-.17.2-.35.22-.64.07-.29-.15-1.23-.45-2.34-1.44-.86-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.59.13-.13.29-.35.44-.52.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.29-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.19 1.87.12.57-.08 1.73-.71 1.98-1.39.24-.68.24-1.27.17-1.39-.08-.12-.27-.19-.56-.34z',
};

const iconClass = variant === 'mobile' ? 'mobile-social-link' : 'social-link';
const whatsappClass = (isWa: boolean) => (isWa ? ' whatsapp' : '');
---

{
  variant === 'mobile' ? (
    <div class="mobile-socials" aria-label="Sweeyam Life social media">
      {SOCIALS.map((s) => (
        <a
          class={`${iconClass}${whatsappClass(!!s.whatsapp)}`}
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          title={s.name}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons[s.name]} />
          </svg>
        </a>
      ))}
    </div>
  ) : (
    <div class="social-links" aria-label="Sweeyam Life social media">
      {SOCIALS.map((s) => (
        <a
          class={`${iconClass}${whatsappClass(!!s.whatsapp)}`}
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          title={s.name}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons[s.name]} />
          </svg>
        </a>
      ))}
    </div>
  )
}

<style>
  .social-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .social-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid var(--line-dark);
    color: var(--on-dark-soft);
    transition: color var(--dur-normal) var(--ease), background var(--dur-normal) var(--ease), border-color var(--dur-normal) var(--ease), transform var(--dur-normal) var(--ease);
  }
  .social-link:hover { color: var(--on-dark); border-color: var(--brass-light); transform: translateY(-2px); }
  .social-link.whatsapp:hover { color: var(--brass-light); }
  .social-link svg { width: 20px; height: 20px; fill: currentColor; }

  .mobile-socials { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .mobile-social-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    color: var(--on-dark);
    transition: background var(--dur-quick) var(--ease), color var(--dur-quick) var(--ease), border-color var(--dur-quick) var(--ease), transform var(--dur-quick) var(--ease);
  }
  .mobile-social-link:hover { background: var(--navy); border-color: var(--navy); color: #fff; transform: translateY(-2px); }
  .mobile-social-link.whatsapp:hover { background: var(--green); border-color: var(--green); color: #fff; }
  .mobile-social-link svg { width: 20px; height: 20px; fill: currentColor; }
</style>
