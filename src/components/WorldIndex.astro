---
import { getCollection } from 'astro:content';

const worlds = (await getCollection('worlds')).sort((a, b) =>
  a.data.num.localeCompare(b.data.num, undefined, { numeric: true })
);
---

<div class="world-index-wrap" data-world-index>
  <ol class="world-index-list" aria-label="Explore our product worlds">
    {worlds.map((w, i) => (
      <li class:list={['world-index-row', i === 0 && 'active']}>
        <button class="world-index-btn" type="button" aria-pressed={i === 0}>
          <span class="world-index-name">{w.data.name}</span>
        </button>
      </li>
    ))}
  </ol>

  <div class="world-index-stage" aria-hidden="true">
    {worlds.map((w, i) => (
      <img loading="lazy" class:list={['world-index-img', i === 0 && 'active']} src={w.data.image} alt="" />
    ))}
  </div>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-world-index]');
  if (wrap) {
    const rows = Array.from(wrap.querySelectorAll<HTMLLIElement>('.world-index-row'));
    const imgs = Array.from(wrap.querySelectorAll<HTMLImageElement>('.world-index-img'));
    const touchLayout = window.matchMedia('(hover: none), (pointer: coarse)');
    let current = 0;

    const setWorld = (index: number) => {
      const safe = Math.max(0, Math.min(rows.length - 1, index));
      if (safe === current) return;
      current = safe;
      rows.forEach((row, i) => {
        const active = i === safe;
        row.classList.toggle('active', active);
        row.querySelector<HTMLButtonElement>('.world-index-btn')?.setAttribute('aria-pressed', String(active));
      });
      imgs.forEach((img, i) => img.classList.toggle('active', i === safe));
    };

    rows.forEach((row, index) => {
      row.addEventListener('mouseenter', () => setWorld(index));
      row.addEventListener('click', () => setWorld(index));
      row.addEventListener('focusin', () => setWorld(index));
    });

    if (!touchLayout.matches) {
      wrap.addEventListener('mouseleave', () => setWorld(0));
    }
  }
</script>

<style>
  .world-index-wrap {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .world-index-list { list-style: none; margin: 0; padding: 0; }

  .world-index-btn {
    display: block;
    width: 100%;
    padding: clamp(0.85rem, 2vw, 1.15rem) 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .world-index-name {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    line-height: 1.1;
    color: var(--on-dark-soft);
    transition: color var(--dur-normal) var(--ease), padding-left var(--dur-normal) var(--ease);
  }

  .world-index-row:hover .world-index-name,
  .world-index-row:focus-within .world-index-name,
  .world-index-row.active .world-index-name {
    color: var(--brass-light);
    padding-left: var(--space-md);
  }

  .world-index-stage {
    position: relative;
    align-self: flex-start;
    aspect-ratio: 4 / 5;
    max-height: 24rem;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--navy-deep);
    box-shadow: var(--shadow-card);
  }
  .world-index-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity var(--dur-slow) var(--ease), transform 1.2s var(--ease); }
  .world-index-img.active { opacity: 1; transform: scale(1); }

  @media (max-width: 64rem) {
    .world-index-wrap { grid-template-columns: 1fr; }
    .world-index-stage { order: -1; aspect-ratio: 16 / 9; max-height: 15rem; }
  }
</style>
