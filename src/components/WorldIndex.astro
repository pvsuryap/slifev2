---
import { getCollection } from 'astro:content';

const worlds = (await getCollection('worlds')).sort((a, b) =>
  a.data.num.localeCompare(b.data.num, undefined, { numeric: true })
);
---

<div class="idisp" data-world-index>
  <div class="idisp-slices">
    {worlds.map((w, i) => (
      <button
        class="idisp-slice"
        type="button"
        style={`--bg: url('${w.data.image}'); --i: ${i};`}
        data-img={w.data.image}
        aria-pressed="false"
      >
        <span class="idisp-slice-name">{w.data.name}</span>
      </button>
    ))}
  </div>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-world-index]');
  if (wrap) {
    const slices = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.idisp-slice'));
    const imgs = slices.map((s) => s.dataset.img ?? '');
    const isMobile = () => window.matchMedia('(max-width: 48rem)').matches;

    const join = (index: number) => {
      if (isMobile()) return;
      if (index === -1) {
        slices.forEach((slice, i) => {
          slice.style.setProperty('--bg', `url('${imgs[i]}')`);
          slice.setAttribute('aria-pressed', 'false');
        });
        wrap.classList.remove('joining');
        return;
      }
      slices.forEach((slice) => {
        slice.style.setProperty('--bg', `url('${imgs[index]}')`);
        slice.setAttribute('aria-pressed', String(true));
      });
      wrap.classList.add('joining');
    };

    slices.forEach((slice, index) => {
      slice.addEventListener('mouseenter', () => join(index));
      slice.addEventListener('focusin', () => join(index));
    });

    wrap.addEventListener('mouseleave', () => join(-1));

    let scrollTicking = false;
    const onScroll = () => {
      if (!scrollTicking) {
        scrollTicking = true;
        requestAnimationFrame(() => {
          join(-1);
          scrollTicking = false;
        });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .idisp {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 26rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(8, 22, 39, 0.5);
    border: 1px solid rgba(244, 239, 230, 0.14);
  }

  .idisp-slices {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .idisp-slice {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0.5rem 0;
    border: 0;
    cursor: pointer;
    color: var(--on-dark);
    transition: opacity var(--dur-normal) var(--ease);
  }
  .idisp-slice + .idisp-slice { border-left: 1px solid rgba(8, 22, 39, 0.45); }

  .idisp-slice::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--bg);
    background-size: 500% 100%;
    background-position: calc(var(--i) * 25%) 50%;
    filter: blur(5px) brightness(0.75);
    transform: scale(1.08);
    transition: filter var(--dur-normal) var(--ease);
  }

  .idisp-slice::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(8, 22, 39, 0.05) 40%, rgba(8, 22, 39, 0.72) 100%);
    transition: opacity var(--dur-normal) var(--ease);
  }

  .idisp-slice-name {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: clamp(0.5rem, 0.9vw, 0.85rem) 0 clamp(0.6rem, 1vw, 1rem);
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.15vw, 1.05rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.15;
    text-transform: none;
    text-align: center;
    color: var(--white);
    transition: opacity var(--dur-normal) var(--ease);
  }

  /* Joined: all slices show the same image as one, unblurred */
  .idisp.joining .idisp-slice::before {
    filter: blur(0) brightness(1);
    transform: scale(1);
  }
  .idisp.joining .idisp-slice::after { opacity: 0; }
  .idisp.joining .idisp-slice-name { opacity: 0; }
  .idisp.joining .idisp-slice { border-color: transparent; }

  .idisp-slice:hover,
  .idisp-slice:focus-visible { outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .idisp-slice::before { transition: none; }
  }

  @media (max-width: 48rem) {
    .idisp { aspect-ratio: auto; height: auto; }
    .idisp-slices {
      position: static;
      inset: auto;
      width: 100%;
      aspect-ratio: 16 / 9;
      grid-template-columns: repeat(5, 100%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .idisp-slice { scroll-snap-align: center; }
    .idisp-slice::before {
      background-size: cover;
      background-position: center;
      filter: brightness(0.7);
    }
  }
</style>
